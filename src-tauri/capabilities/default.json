{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the renderer-created Agent Dashboard pop-out",
  "windows": [
    "main",
    "rosetta",
    "agent-dashboard"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "opener:default",
    "dialog:default"
  ],
  "remote": {
    "urls": [
      "http://localhost:1421/*"
    ]
  }
}
